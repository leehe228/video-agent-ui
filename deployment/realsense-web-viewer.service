[Unit]
Description=Three-camera Intel RealSense capture backend
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/video-agent-ui/backend
ExecStart=/usr/bin/sg video -c "/usr/bin/python3 %h/video-agent-ui/backend/server.py --bind 127.0.0.1 --port 8765 --width 424 --height 240 --fps 10 --profile-state %h/.config/video-agent-ui/camera-profiles.json --serials 405622073775,405622072503,401622073398"
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
LimitNOFILE=4096

[Install]
WantedBy=default.target
