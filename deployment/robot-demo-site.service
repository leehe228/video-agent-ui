[Unit]
Description=Workcell Console with three RealSense streams
After=network.target realsense-web-viewer.service
Wants=realsense-web-viewer.service

[Service]
Type=simple
WorkingDirectory=%h/video-agent-ui/site
ExecStart=%h/.local/node22/node_modules/node/bin/node %h/video-agent-ui/site/node_modules/vinext/dist/cli.js start -p 8080 -H 0.0.0.0
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production
Environment=REALSENSE_STATUS_URL=http://127.0.0.1:8765/api/status
Environment=REALSENSE_STREAM_BASE_URL=http://127.0.0.1:8765
LimitNOFILE=4096

[Install]
WantedBy=default.target
